# Exemplo de nomes usados na hospedagem. Não coloque valores reais neste arquivo.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
AllowedHosts=seu-dominio.example
ConnectionStrings__DefaultConnection=
Database__ApplyMigrations=true
FrameImageStorage__Path=/data/frame-images
LaboratoryDocumentStorage__Path=/data/laboratory-documents
DataProtection__KeysPath=/data/data-protection-keys
Email__Host=smtp.seu-provedor.com
Email__Port=587
Email__UserName=
Email__Password=
Email__FromAddress=contato@seu-dominio.example
Email__FromName=Ótica Visão de Piabetá
Email__UseSsl=true
AdminAccounts__Accounts__0__DisplayName=
AdminAccounts__Accounts__0__Email=
AdminAccounts__Accounts__0__Password=
