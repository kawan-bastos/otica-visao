@page
@using OticaVisao.Domain.Catalog
@model OticaVisao.Web.Pages.Frames.IndexModel
@{
    ViewData["Title"] = "Catálogo de armações";
}

<main class="public-catalog">
    <header class="catalog-hero">
        <div class="site-container">
            <span class="eyebrow">Catálogo online</span>
            <h1>Encontre uma armação para experimentar na loja.</h1>
            <p>Veja os modelos disponíveis e converse com nossa equipe antes de visitar a Ótica Visão de Piabetá.</p>
        </div>
    </header>

    <section class="site-container catalog-promotion" aria-labelledby="catalog-promotion-title">
        <div class="catalog-promotion__price">
            <span>Armação por</span>
            <strong>R$ 39</strong>
        </div>
        <div class="catalog-promotion__content">
            <span class="eyebrow">Condição especial</span>
            <h2 id="catalog-promotion-title">Complete seus óculos com a gente.</h2>
            <p>Na compra dos óculos completos, a armação sai por R$ 39. Consulte modelos e condições com nossa equipe.</p>
        </div>
        <a class="button button--primary" href="https://wa.me/5521965912440?text=Ol%C3%A1%21%20Gostaria%20de%20saber%20mais%20sobre%20a%20promo%C3%A7%C3%A3o%20da%20arma%C3%A7%C3%A3o%20por%20R%24%2039." target="_blank" rel="noopener noreferrer">Consultar condições</a>
    </section>

    <div class="site-container catalog-layout">
        <form method="get" class="catalog-filters">
            <div class="catalog-filters__heading">
                <h2>Encontre sua armação</h2>
                <p>Busque pelo nome ou refine os modelos usando os filtros.</p>
            </div>
            <div class="form-field">
                <label asp-for="Search">Buscar</label>
                <input asp-for="Search" placeholder="Marca, modelo, cor ou código" />
            </div>
            <div class="form-field">
                <label asp-for="Type">Tipo</label>
                <select asp-for="Type">
                    <option value="">Todos</option>
                    <option value="Prescription">Óculos de grau</option>
                    <option value="Sunglasses">Óculos de sol</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="Shape">Formato</label>
                <select asp-for="Shape">
                    <option value="">Todos</option>
                    <option value="Round">Redondo</option>
                    <option value="Square">Quadrado</option>
                    <option value="Aviator">Aviador</option>
                    <option value="Other">Outro</option>
                </select>
            </div>
            <div class="form-field">
                <label asp-for="TargetAudience">Público</label>
                <select asp-for="TargetAudience">
                    <option value="">Todos</option>
                    <option value="Adult">Adulto</option>
                    <option value="Child">Infantil</option>
                </select>
            </div>
            <button class="button button--primary" type="submit">Buscar armações</button>
            <a class="catalog-filters__clear" asp-page="Index">Limpar filtros</a>
        </form>

        <section class="catalog-results" aria-live="polite">
            @if (TempData["CatalogMessage"] is string message) { <div class="admin-alert admin-alert--success">@message</div> }
            @if (TempData["CatalogError"] is string error) { <div class="admin-alert admin-alert--error">@error</div> }
            <div class="catalog-results__heading">
                <h2>Modelos disponíveis</h2>
                <span>@Model.Frames.Count @(Model.Frames.Count == 1 ? "armação" : "armações")</span>
            </div>
            @if (Model.Frames.Count == 0)
            {
                <div class="catalog-empty">
                    <h3>Nenhuma armação encontrada</h3>
                    <p>Altere os filtros ou fale com nossa equipe para conhecer outras opções.</p>
                </div>
            }
            else
            {
                <div class="catalog-grid">
                    @foreach (var frame in Model.Frames)
                    {
                        <article class="frame-card">
                            <a class="frame-card__visual" asp-page="Details" asp-route-id="@frame.Id">
                                @if (frame.ImageFileName is not null)
                                {
                                    <span class="frame-card__photo-backdrop" style="background-image:url('/frame-images/@frame.ImageFileName')" aria-hidden="true"></span>
                                    <img src="/frame-images/@frame.ImageFileName" alt="@frame.Brand @frame.Model na cor @frame.Color" />
                                }
                                else
                                {
                                    <partial name="_DemoFrameImage" model="frame.Id" />
                                }
                            </a>
                            @if (User.Identity?.IsAuthenticated == true && !User.IsInRole(OticaVisao.Infrastructure.Authentication.AdminAuthorization.Role))
                            {
                                var isFavorite = Model.FavoriteIds.Contains(frame.Id);
                                <form class="catalog-frame__favorite" method="post" asp-page-handler="Favorite" data-ajax-favorite>
                                    <input type="hidden" name="frameId" value="@frame.Id" />
                                    <button class="catalog-frame__favorite-button @(isFavorite ? "is-favorite" : null)" type="submit" aria-label="@(isFavorite ? "Remover dos favoritos" : "Adicionar aos favoritos")" title="@(isFavorite ? "Remover dos favoritos" : "Adicionar aos favoritos")" aria-pressed="@isFavorite.ToString().ToLowerInvariant()">@(isFavorite ? "♥" : "♡")</button>
                                </form>
                            }
                            else if (User.Identity?.IsAuthenticated != true)
                            {
                                <a class="catalog-frame__favorite-button catalog-frame__favorite-login" asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Frames/Index")" aria-label="Entrar para adicionar aos favoritos" title="Entrar para adicionar aos favoritos">♡</a>
                            }
                            <div class="frame-card__body">
                                <p class="frame-card__brand">@frame.Brand · @IndexModel.TypeName(frame.Type)</p>
                                <h3>@frame.Model</h3>
                                <p class="frame-card__color">@frame.Color · Código @frame.Code</p>
                                <div class="frame-card__footer">
                                    <strong>@frame.Price.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong>
                                    <a asp-page="Details" asp-route-id="@frame.Id">Ver detalhes</a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</main>
