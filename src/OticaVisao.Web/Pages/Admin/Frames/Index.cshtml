@page
@using OticaVisao.Domain.Catalog
@model OticaVisao.Web.Pages.Admin.Frames.IndexModel
@{
    ViewData["Title"] = "Armações do catálogo";
}

<main class="admin-page">
    <header class="admin-page__header">
        <div>
            <span class="eyebrow">Painel administrativo</span>
            <h1>Armações do catálogo</h1>
            <p>Consulte os modelos, preços, estoque e publicação cadastrados.</p>
        </div>
        <a class="button button--primary" asp-page="Create">Cadastrar armação</a>
    </header>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="admin-alert admin-alert--success" role="status">@successMessage</div>
    }

    @if (Model.Frames.Count == 0)
    {
        <div class="admin-empty">
            <h2>Nenhuma armação cadastrada</h2>
            <p>Os produtos adicionados ao catálogo aparecerão aqui.</p>
        </div>
    }
    else
    {
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Foto</th>
                        <th>Armação</th>
                        <th>Tipo</th>
                        <th>Preço</th>
                        <th>Estoque</th>
                        <th>Status</th>
                        <th><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var frame in Model.Frames)
                    {
                        <tr>
                            <td data-label="Código"><strong>@frame.Code</strong></td>
                            <td data-label="Foto">
                                @if (frame.ImageFileName is not null)
                                {
                                    <img class="admin-frame-thumbnail" src="/frame-images/@frame.ImageFileName" alt="@frame.Brand @frame.Model" />
                                }
                                else
                                {
                                    <span class="admin-frame-thumbnail admin-frame-thumbnail--empty">Sem foto</span>
                                }
                            </td>
                            <td data-label="Armação">@frame.Brand @frame.Model <small>@frame.Color</small></td>
                            <td data-label="Tipo">@(frame.Type == FrameType.Sunglasses ? "Óculos de sol" : "Óculos de grau")</td>
                            <td data-label="Preço">@frame.Price.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                            <td data-label="Estoque">@frame.StockQuantity</td>
                            <td data-label="Status">
                                <span class="status-badge @(frame.IsAvailable ? "status-badge--available" : "status-badge--unavailable")">
                                    @(frame.IsAvailable ? "Disponível" : "Indisponível")
                                </span>
                            </td>
                            <td class="admin-table__actions" data-label="Ações">
                                <a asp-page="Edit" asp-route-id="@frame.Id">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
