@model OticaVisao.Domain.Sales.LensPrescription
@functions { static string V(object? value) => value?.ToString() ?? "—"; }
<div class="prescription-cards">
    @foreach (var row in new[] { ("Longe", "OD", Model.FarRight), ("Longe", "OE", Model.FarLeft), ("Perto", "OD", Model.NearRight), ("Perto", "OE", Model.NearLeft) })
    {
        <section class="prescription-card">
            <h4>@row.Item1 · @(row.Item2 == "OD" ? "OD — Olho direito" : "OE — Olho esquerdo")</h4>
            <dl>
                <div><dt>Esférico</dt><dd>@V(row.Item3.Sphere)</dd></div>
                <div><dt>Cilíndrico</dt><dd>@V(row.Item3.Cylinder)</dd></div>
                <div><dt>Eixo (°)</dt><dd>@V(row.Item3.Axis)</dd></div>
                <div><dt>DNP (mm)</dt><dd>@V(row.Item3.Dnp)</dd></div>
                <div><dt>Altura (mm)</dt><dd>@V(row.Item3.Height)</dd></div>
                <div><dt>Adição</dt><dd>@V(row.Item3.Addition)</dd></div>
            </dl>
        </section>
    }
</div>
