@model OticaVisao.Domain.Sales.LensPrescription
@functions { static string V(object? value) => value?.ToString() ?? "—"; }
<div class="admin-table-wrapper"><table class="admin-table prescription-table">
    <thead><tr><th>Uso</th><th>Olho</th><th>Esférico</th><th>Cilíndrico</th><th>Eixo</th><th>DNP</th><th>Altura</th><th>Adição</th></tr></thead>
    <tbody>
    @foreach (var row in new[] { ("Longe", "OD", Model.FarRight), ("Longe", "OE", Model.FarLeft), ("Perto", "OD", Model.NearRight), ("Perto", "OE", Model.NearLeft) })
    { <tr><td>@row.Item1</td><th>@row.Item2</th><td>@V(row.Item3.Sphere)</td><td>@V(row.Item3.Cylinder)</td><td>@V(row.Item3.Axis)</td><td>@V(row.Item3.Dnp)</td><td>@V(row.Item3.Height)</td><td>@V(row.Item3.Addition)</td></tr> }
    </tbody>
</table></div>
