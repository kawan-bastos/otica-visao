@page
@using OticaVisao.Domain.Costs
@model OticaVisao.Web.Pages.Admin.Reports.CostsModel
@{ ViewData["Title"] = "Custos"; var culture = System.Globalization.CultureInfo.GetCultureInfo("pt-BR"); var max = Model.Report.Categories.Max(x => x.Current); }
<main class="admin-page cost-page">
    <partial name="/Pages/Admin/_AdminNavigation.cshtml" /><partial name="/Pages/Admin/Reports/_ReportNavigation.cshtml" />
    <header class="cost-header"><div><span class="eyebrow">Controle financeiro</span><h1>Custos da operação</h1><p>@Model.Report.Month.ToString("MMMM 'de' yyyy", culture)</p></div><form method="get"><label for="month">Mês</label><input id="month" name="month" type="month" value="@Model.Month" onchange="this.form.submit()" /></form></header>
    @if (TempData["CostMessage"] is string ok) { <div class="admin-alert admin-alert--success">@ok</div> } @if (TempData["CostError"] is string error) { <div class="admin-alert admin-alert--error">@error</div> }
    <section class="cost-summary">
        <article><span>Custo no mês</span><strong>@Model.Report.MonthToDate.ToString("C", culture)</strong><b class="@(Model.Report.MonthToDate <= Model.Report.PreviousMonth ? "positive" : "negative")">@Delta(Model.Report.MonthToDate, Model.Report.PreviousMonth)</b><small>comparado ao mês anterior</small></article>
        <article><span>Previsão do mês</span><strong>@Model.Report.Forecast.ToString("C", culture)</strong><small>Projeção pelo ritmo diário registrado.</small></article>
        <article><span>Orçamento</span><strong>@Model.Report.Budget.ToString("C", culture)</strong><div class="cost-budget-track"><i class="@(Model.Report.BudgetUsed >= 80 ? "warning" : null)" style="width:@Math.Min(100,Model.Report.BudgetUsed).ToString("0.#",System.Globalization.CultureInfo.InvariantCulture)%"></i></div><small>@Model.Report.BudgetUsed.ToString("0.#")% utilizado</small></article>
    </section>
    <section class="cost-actions">
        <form method="post" asp-page-handler="Add"><input type="hidden" name="Month" value="@Model.Month"/><div><label asp-for="Category">Categoria</label><select asp-for="Category"><option value="">Selecione</option>@foreach(var category in Enum.GetValues<CostCategory>()){<option value="@category">@CategoryName(category)</option>}</select></div><div><label asp-for="Description">Descrição</label><input asp-for="Description" placeholder="Ex.: conta de energia"/></div><div><label asp-for="Amount">Valor</label><input asp-for="Amount" inputmode="decimal" min="0.01" max="99999999" step="0.01" placeholder="0,00"/></div><div><label asp-for="Date">Data</label><input asp-for="Date" type="date"/></div><button class="button button--primary">Registrar custo</button></form>
        <form method="post" asp-page-handler="Budget"><input type="hidden" name="Month" value="@Model.Month"/><div><label asp-for="Budget">Orçamento mensal</label><input asp-for="Budget" inputmode="decimal" min="0" max="99999999" step="0.01"/></div><button class="analytics-export">Definir orçamento</button></form>
    </section>
    <section class="cost-table-card"><div class="admin-form__section-heading"><h2>Custos por categoria</h2><p>Participação e comparação mensal.</p></div><div class="admin-table-wrapper"><table class="admin-table cost-table"><thead><tr><th>Categoria</th><th>Este mês</th><th>Mês anterior</th><th>Variação</th><th>Participação</th></tr></thead><tbody>@foreach(var row in Model.Report.Categories){<tr class="@(row.Current == max && max > 0 ? "largest" : null)"><td data-label="Categoria"><strong>@CategoryName(row.Category)</strong></td><td data-label="Este mês">@row.Current.ToString("C",culture)</td><td data-label="Mês anterior">@row.Previous.ToString("C",culture)</td><td data-label="Variação"><span class="cost-change @(row.Current <= row.Previous ? "positive" : "negative")">@(row.Current <= row.Previous ? "↓" : "↑") @Delta(row.Current,row.Previous)</span></td><td data-label="Participação"><div class="cost-share"><i style="width:@row.Share.ToString("0.#",System.Globalization.CultureInfo.InvariantCulture)%"></i></div><small>@row.Share.ToString("0.#")%</small></td></tr>}</tbody></table></div><footer><span>Valores não incluem tributos não registrados como despesas.</span><span>Dados atualizados a cada novo lançamento.</span></footer></section>
</main>
@functions { static string CategoryName(CostCategory value)=>value switch{CostCategory.Frames=>"Compra de armações",CostCategory.Laboratories=>"Laboratórios",CostCategory.Rent=>"Aluguel",CostCategory.Utilities=>"Energia e serviços",CostCategory.Marketing=>"Marketing",CostCategory.Salaries=>"Salários",_=>"Outros"}; static string Delta(decimal current,decimal previous){var value=previous==0?(current==0?0:100):(current-previous)/previous*100;return $"{(value>=0?"+":"")}{value:0.#}%";} }
