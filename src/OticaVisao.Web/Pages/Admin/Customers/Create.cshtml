@page
@model OticaVisao.Web.Pages.Admin.Customers.CreateModel
@{ ViewData["Title"] = "Cadastrar cliente"; }

<main class="admin-page admin-page--form">
    <partial name="/Pages/Admin/_AdminNavigation.cshtml" />
    <header class="admin-page__header">
        <div><span class="eyebrow">Painel administrativo</span><h1>Cadastrar cliente</h1><p>Crie uma ficha simples para o atendimento da loja.</p></div>
        <a class="button button--secondary" asp-page="Index">Voltar aos clientes</a>
    </header>
    <form method="post" class="admin-form">
        <partial name="_CustomerForm" for="Input" />
        <div class="admin-form__actions"><a class="button button--secondary" asp-page="Index">Cancelar</a><button class="button button--primary" type="submit">Cadastrar cliente</button></div>
    </form>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
