@page "{id:guid}"
@model OticaVisao.Web.Pages.Admin.Customers.EditModel
@{ ViewData["Title"] = "Editar cliente"; }

<main class="admin-page admin-page--form">
    <partial name="/Pages/Admin/_AdminNavigation.cshtml" />
    <header class="admin-page__header">
        <div><span class="eyebrow">Painel administrativo</span><h1>Editar cliente</h1><p>Atualize os dados e observações da ficha.</p></div>
        <a class="button button--secondary" asp-page="Index">Voltar aos clientes</a>
    </header>
    <form method="post" asp-route-id="@Model.CustomerId" class="admin-form">
        <partial name="_CustomerForm" for="Input" />
        <div class="admin-form__actions"><a class="button button--secondary" asp-page="Index">Cancelar</a><button class="button button--primary" type="submit">Salvar alterações</button></div>
    </form>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
