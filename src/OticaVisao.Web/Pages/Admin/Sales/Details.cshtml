@page "{id:guid}"
@using OticaVisao.Domain.Sales
@model OticaVisao.Web.Pages.Admin.Sales.DetailsModel
@{ ViewData["Title"] = Model.Sale.Status == SaleStatus.Draft ? "Venda em andamento" : "Detalhes da venda"; }

<main class="admin-page">
    <partial name="/Pages/Admin/_AdminNavigation.cshtml" />
    <header class="admin-page__header">
        <div><span class="eyebrow">@(Model.Sale.Status == SaleStatus.Draft ? "Venda em andamento" : "Venda encerrada")</span><h1>@Model.Sale.CustomerName</h1><p>@(Model.Sale.Status == SaleStatus.Draft ? "O estoque dos itens está reservado até a conclusão ou o cancelamento." : "Consulte os itens e os dados finais desta venda.")</p></div>
        <a class="button button--secondary" asp-page="Index">Voltar às vendas</a>
    </header>
    <section class="sale-draft-card">
        <div><span>Cliente</span><strong>@Model.Sale.CustomerName</strong></div>
        <div><span>Telefone</span><strong>@Model.Sale.CustomerPhone</strong></div>
        <div><span>Iniciada em</span><strong>@Model.Sale.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
        <div><span>Itens</span><strong>@Model.Sale.Items.Sum(item => item.Quantity)</strong></div>
        <div><span>Total parcial</span><strong>@Model.Sale.Total.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong></div>
        <div><span>Situação</span><strong>@StatusName(Model.Sale.Status)</strong></div>
        @if (Model.Sale.Status == SaleStatus.Completed)
        {
            <div><span>Pagamento</span><strong>@PaymentName(Model.Sale.PaymentMethod)@(Model.Sale.Installments > 1 ? $" · {Model.Sale.Installments}x sem juros" : "")</strong></div>
            <div><span>Concluída em</span><strong>@Model.Sale.CompletedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
        }
        else if (Model.Sale.Status == SaleStatus.Cancelled)
        {
            <div><span>Cancelada em</span><strong>@Model.Sale.CancelledAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
        }
        else if (Model.Sale.Status == SaleStatus.Reversed)
        {
            <div><span>Estornada em</span><strong>@Model.Sale.ReversedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong></div>
            <div><span>Responsável</span><strong>@Model.Sale.ReversedBy</strong></div>
            <div class="sale-next-step"><span>Motivo do estorno</span><strong>@Model.Sale.ReversalReason</strong></div>
        }
    </section>

    @if (TempData["SaleSuccessMessage"] is string successMessage)
    {
        <div class="admin-alert admin-alert--success" role="status">@successMessage</div>
    }

    <section class="sale-items-section">
        <div class="admin-form__section-heading"><h2>Itens da venda</h2><p>O estoque fica reservado enquanto o item permanecer neste rascunho.</p></div>
        @if (Model.Sale.Items.Count == 0)
        {
            <div class="admin-empty"><h3>Nenhum item adicionado</h3><p>Use o formulário abaixo para incluir a primeira armação.</p></div>
        }
        else
        {
            <div class="admin-table-wrapper">
                <table class="admin-table">
                    <thead><tr><th>Armação</th><th>Qtd.</th><th>Lentes</th><th>Laboratório</th><th>Total</th><th><span class="visually-hidden">Ações</span></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Sale.Items)
                    {
                        <tr>
                            <td data-label="Armação"><strong>@item.FrameBrand @item.FrameModel</strong><small>@item.FrameCode · @item.FrameColor · armação @item.FrameUnitPrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</small></td>
                            <td data-label="Qtd.">@item.Quantity</td>
                            <td data-label="Lentes">@(item.IncludesLenses ? $"{item.LensDescription} · {item.LensUnitPrice.ToString("C", new System.Globalization.CultureInfo("pt-BR"))}" : "Sem lentes")</td>
                            <td data-label="Laboratório">@LaboratoryName(item.Laboratory)</td>
                            <td data-label="Total"><strong>@item.Total.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong></td>
                            <td class="admin-table__actions" data-label="Ações">@if (Model.Sale.Status == SaleStatus.Draft) { <form method="post" asp-page-handler="RemoveItem"><input type="hidden" name="id" value="@Model.Sale.Id" /><input type="hidden" name="itemId" value="@item.Id" /><button class="admin-table__button admin-table__button--danger" type="submit">Remover</button></form> }</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (Model.Sale.Status == SaleStatus.Draft)
    {
    <form method="post" asp-page-handler="AddItem" class="admin-form sale-item-form">
        <input type="hidden" name="id" value="@Model.Sale.Id" />
        <div asp-validation-summary="ModelOnly" class="form-validation" role="alert"></div>
        <section class="admin-form__section">
            <div class="admin-form__section-heading"><h2>Adicionar armação</h2><p>Óculos completo aplica automaticamente o preço promocional de R$ 39 na armação.</p></div>
            <div class="form-grid form-grid--three">
                <div class="form-field form-field--wide"><label asp-for="Input.FrameId"></label><select asp-for="Input.FrameId"><option value="">Selecione</option>@foreach (var frame in Model.AvailableFrames) { <option value="@frame.Id">@frame.Code · @frame.Brand @frame.Model · @frame.Color · estoque @frame.StockQuantity</option> }</select><span asp-validation-for="Input.FrameId"></span></div>
                <div class="form-field"><label asp-for="Input.Quantity"></label><input asp-for="Input.Quantity" type="number" min="1" /><span asp-validation-for="Input.Quantity"></span></div>
                <label class="form-checkbox sale-complete-toggle"><input asp-for="Input.IncludesLenses" data-sale-includes-lenses /><span><strong>Óculos completo</strong><small>Inclui lentes e armação promocional por R$ 39</small></span></label>
            </div>
            <div class="form-grid form-grid--three" data-sale-lens-fields>
                <div class="form-field form-field--wide"><label asp-for="Input.LensDescription"></label><input asp-for="Input.LensDescription" placeholder="Ex.: visão simples, antirreflexo" /><span asp-validation-for="Input.LensDescription"></span></div>
                <div class="form-field"><label asp-for="Input.LensUnitPrice"></label><input asp-for="Input.LensUnitPrice" inputmode="decimal" /><span asp-validation-for="Input.LensUnitPrice"></span></div>
                <div class="form-field"><label asp-for="Input.Laboratory"></label><select asp-for="Input.Laboratory"><option value="">Selecione</option><option value="StandardOptical">Padrão Optical</option><option value="ImperialLab">Imperial Lab</option></select><span asp-validation-for="Input.Laboratory"></span></div>
            </div>
        </section>
        <div class="admin-form__actions"><button class="button button--primary" type="submit" @(Model.AvailableFrames.Count == 0 ? "disabled" : null)>Adicionar à venda</button></div>
    </form>

    <section class="sale-checkout">
        <form method="post" asp-page-handler="Complete" class="admin-form">
            <input type="hidden" name="id" value="@Model.Sale.Id" />
            <div asp-validation-summary="ModelOnly" class="form-validation" role="alert"></div>
            <section class="admin-form__section">
                <div class="admin-form__section-heading"><h2>Concluir venda</h2><p>Confira o total e registre como o cliente pagou.</p></div>
                <div class="form-grid form-grid--three">
                    <div class="form-field"><label asp-for="Payment.PaymentMethod"></label><select asp-for="Payment.PaymentMethod" data-payment-method><option value="">Selecione</option><option value="Pix">Pix</option><option value="DebitCard">Cartão de débito</option><option value="CreditCard">Cartão de crédito</option></select><span asp-validation-for="Payment.PaymentMethod"></span></div>
                    <div class="form-field" data-installments><label asp-for="Payment.Installments"></label><select asp-for="Payment.Installments">@for (var installment = 1; installment <= 10; installment++) { <option value="@installment">@(installment == 1 ? "1x (à vista)" : $"{installment}x sem juros")</option> }</select><span asp-validation-for="Payment.Installments"></span></div>
                    <div class="sale-checkout__total"><span>Total final</span><strong>@Model.Sale.Total.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong></div>
                </div>
            </section>
            <div class="admin-form__actions"><a class="button button--secondary" asp-page="Cancel" asp-route-id="@Model.Sale.Id">Cancelar venda</a><button class="button button--primary" type="submit" @(Model.Sale.Items.Count == 0 ? "disabled" : null)>Concluir venda</button></div>
        </form>
    </section>
    }
    else if (Model.Sale.Status == SaleStatus.Completed)
    {
        <div class="sale-closed-actions"><a class="button button--danger-outline" asp-page="Reverse" asp-route-id="@Model.Sale.Id">Estornar venda</a></div>
    }
</main>

@functions {
    private static string LaboratoryName(OpticalLaboratory? laboratory) => laboratory switch
    {
        OpticalLaboratory.StandardOptical => "Padrão Optical",
        OpticalLaboratory.ImperialLab => "Imperial Lab",
        _ => "—"
    };

    private static string StatusName(SaleStatus status) => status switch { SaleStatus.Draft => "Em andamento", SaleStatus.Completed => "Concluída", SaleStatus.Cancelled => "Cancelada", _ => "Estornada" };
    private static string PaymentName(PaymentMethod? payment) => payment switch { PaymentMethod.Pix => "Pix", PaymentMethod.DebitCard => "Cartão de débito", PaymentMethod.CreditCard => "Cartão de crédito", _ => "—" };
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const payment = document.querySelector('[data-payment-method]');
            const installments = document.querySelector('[data-installments]');
            if (!payment || !installments) return;
            const update = () => {
                const credit = payment.value === 'CreditCard';
                installments.hidden = !credit;
                if (!credit) installments.querySelector('select').value = '1';
            };
            payment.addEventListener('change', update);
            update();
        })();
    </script>
}
