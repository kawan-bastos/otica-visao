@page
@model OticaVisao.Web.Pages.Admin.Sales.EditItemModel
@{ ViewData["Title"] = "Editar lentes e grau"; }
<main class="admin-page admin-page--form"><partial name="/Pages/Admin/_AdminNavigation.cshtml" />
<header class="admin-page__header"><div><span class="eyebrow">Venda de @Model.Sale.CustomerName</span><h1>Editar lentes e grau</h1><p>@Model.Item.FrameBrand @Model.Item.FrameModel · @Model.Item.FrameCode</p></div><a class="button button--secondary" asp-page="Details" asp-route-id="@Model.Sale.Id">Voltar</a></header>
<form method="post" class="admin-form"><input type="hidden" name="saleId" value="@Model.Sale.Id"/><input type="hidden" name="itemId" value="@Model.Item.Id"/><div asp-validation-summary="All" class="form-validation"></div><section class="admin-form__section"><div class="form-grid form-grid--three"><div class="form-field form-field--wide"><label asp-for="Input.LensDescription"></label><input asp-for="Input.LensDescription"/><span asp-validation-for="Input.LensDescription"></span></div><div class="form-field"><label asp-for="Input.LensUnitPrice"></label><input asp-for="Input.LensUnitPrice" inputmode="decimal"/></div><div class="form-field"><label asp-for="Input.Laboratory"></label><select asp-for="Input.Laboratory"><option value="StandardOptical">Padrão Optical</option><option value="ImperialLab">Imperial Lab</option></select></div><div class="form-field"><label asp-for="Input.ExpectedDeliveryDate"></label><input asp-for="Input.ExpectedDeliveryDate" type="date" /></div></div><div class="admin-form__section-heading"><h2>Grau das lentes</h2><p>Estes mesmos dados aparecem no pedido ao laboratório.</p></div><partial name="_PrescriptionFields" model="Model.Input.Prescription" /></section><div class="admin-form__actions"><button class="button button--primary" type="submit">Salvar alterações</button></div></form></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
