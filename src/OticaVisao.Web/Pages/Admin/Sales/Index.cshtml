@page
@using OticaVisao.Domain.Sales
@model OticaVisao.Web.Pages.Admin.Sales.IndexModel
@{ ViewData["Title"] = "Vendas"; }

<main class="admin-page">
    <partial name="/Pages/Admin/_AdminNavigation.cshtml" />
    <header class="admin-page__header">
        <div><span class="eyebrow">Painel administrativo</span><h1>Vendas</h1><p>Inicie um atendimento selecionando ou cadastrando o cliente.</p></div>
        <a class="button button--primary" asp-page="Create">Nova venda</a>
    </header>

    @if (TempData["SaleSuccessMessage"] is string successMessage)
    {
        <div class="admin-alert admin-alert--success" role="status">@successMessage</div>
    }

    <form class="customer-search" method="get">
        @if (Model.CustomerId.HasValue) { <input type="hidden" asp-for="CustomerId" /> }
        <div class="form-field"><label asp-for="Search">Buscar venda</label><input asp-for="Search" placeholder="Cliente, telefone, código ou modelo" /></div>
        <button class="button button--primary" type="submit">Buscar</button>
        <a class="button button--secondary" asp-page="Index">Limpar</a>
    </form>

    @if (Model.Sales.Count == 0)
    {
            <div class="admin-empty"><h2>@((Model.CustomerId.HasValue || !string.IsNullOrWhiteSpace(Model.Search)) ? "Nenhuma venda encontrada" : "Nenhuma venda iniciada")</h2><p>@((Model.CustomerId.HasValue || !string.IsNullOrWhiteSpace(Model.Search)) ? "Tente ajustar a busca ou remover o filtro." : "As vendas em andamento e concluídas aparecerão aqui.")</p></div>
    }
    else
    {
        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead><tr><th>Cliente</th><th>Itens</th><th>Total</th><th>Iniciada em</th><th>Situação</th><th><span class="visually-hidden">Ações</span></th></tr></thead>
                <tbody>
                @foreach (var sale in Model.Sales)
                {
                    <tr>
                        <td data-label="Cliente"><strong>@sale.CustomerName</strong></td>
                        <td data-label="Itens">@sale.Items.Sum(item => item.Quantity)</td>
                        <td data-label="Total">@((sale.FinalTotal ?? sale.Total).ToString("C", new System.Globalization.CultureInfo("pt-BR")))</td>
                        <td data-label="Iniciada em">@sale.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td data-label="Situação"><span class="sale-status sale-status--@sale.Status.ToString().ToLowerInvariant()">@StatusName(sale.Status)</span></td>
                        <td class="admin-table__actions" data-label="Ações">
                            <div class="sale-row-actions">
                                <a asp-page="Details" asp-route-id="@sale.Id">@(sale.Status == SaleStatus.Draft ? "Continuar" : "Ver detalhes")</a>
                                @if (sale.Status is SaleStatus.Cancelled or SaleStatus.Reversed) { <a class="sale-delete-link" asp-page="Delete" asp-route-id="@sale.Id">Excluir</a> }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</main>

@functions { private static string StatusName(SaleStatus status) => status switch { SaleStatus.Draft => "Em andamento", SaleStatus.Completed => "Concluída", SaleStatus.Cancelled => "Cancelada", _ => "Estornada" }; }
