@page
@model OticaVisao.Web.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "Alterar senha"; }

<main class="account-edit-page">
    <div class="site-container account-edit-shell account-security-shell">
        <header class="account-edit-header">
            <div><span class="eyebrow">Segurança da conta</span><h1>Alterar senha</h1><p>Confirme sua senha atual e escolha uma nova senha segura.</p></div>
            <a class="button button--secondary" asp-page="Edit">Voltar</a>
        </header>
        <form method="post" class="admin-form account-edit-form account-password-form">
            <div asp-validation-summary="ModelOnly" class="form-validation" role="alert"></div>
            <section class="admin-form__section">
                <div class="form-field"><label asp-for="Input.CurrentPassword"></label><input asp-for="Input.CurrentPassword" autocomplete="current-password" /><span asp-validation-for="Input.CurrentPassword"></span></div>
                <div class="form-field"><label asp-for="Input.NewPassword"></label><input asp-for="Input.NewPassword" autocomplete="new-password" /><span asp-validation-for="Input.NewPassword"></span></div>
                <div class="form-field"><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword"></span></div>
            </section>
            <div class="admin-form__actions"><a class="button button--secondary" asp-page="Edit">Cancelar</a><button class="button button--primary" type="submit">Salvar nova senha</button></div>
        </form>
    </div>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
