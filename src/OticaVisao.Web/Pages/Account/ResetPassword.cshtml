@page
@model OticaVisao.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Criar nova senha"; }

<section class="login-page">
    <div class="login-card">
        <div class="login-card__intro">
            <span class="eyebrow">Código enviado</span>
            <h1>Crie uma nova senha</h1>
            <p>Digite o código de 6 números recebido por e-mail e escolha sua nova senha.</p>
        </div>
        <form method="post" class="login-form">
            <input asp-for="RequestId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="form-validation" role="alert"></div>
            <div class="form-field"><label asp-for="Input.Code"></label><input asp-for="Input.Code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" class="verification-code-input" /><span asp-validation-for="Input.Code"></span></div>
            <div class="form-field"><label asp-for="Input.NewPassword"></label><input asp-for="Input.NewPassword" autocomplete="new-password" /><span asp-validation-for="Input.NewPassword"></span></div>
            <div class="form-field"><label asp-for="Input.ConfirmPassword"></label><input asp-for="Input.ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword"></span></div>
            <button type="submit" class="button button--primary">Redefinir senha</button>
            <p class="account-form__aside">Não recebeu? <a asp-page="ForgotPassword">Solicitar outro código</a></p>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
