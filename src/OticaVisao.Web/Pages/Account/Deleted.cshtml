@page
@model OticaVisao.Web.Pages.Account.DeletedModel
@{ ViewData["Title"] = "Conta excluída"; }

<section class="login-page">
    <div class="login-card login-card--message">
        <span class="eyebrow">Conta excluída</span>
        <h1>Seu acesso foi removido</h1>
        <p>Você já foi desconectado. Sua ficha de atendimento permanece protegida com a Ótica Visão de Piabetá.</p>
        <a class="button button--primary" asp-page="/Index">Voltar ao início</a>
    </div>
</section>
