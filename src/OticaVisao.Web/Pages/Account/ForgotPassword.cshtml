@page
@model OticaVisao.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Esqueci minha senha"; }

<section class="login-page">
    <div class="login-card">
        <div class="login-card__intro">
            <span class="eyebrow">Recuperação de acesso</span>
            <h1>Vamos recuperar sua conta</h1>
            <p>Informe o e-mail cadastrado. Enviaremos um código de verificação válido por 10 minutos.</p>
        </div>
        <form method="post" class="login-form">
            <div asp-validation-summary="ModelOnly" class="form-validation" role="alert"></div>
            <div class="form-field"><label asp-for="Input.Email"></label><input asp-for="Input.Email" autocomplete="email" /><span asp-validation-for="Input.Email"></span></div>
            <button type="submit" class="button button--primary">Enviar código</button>
            <p class="account-form__aside"><a asp-page="Login">Voltar para entrar</a></p>
        </form>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
