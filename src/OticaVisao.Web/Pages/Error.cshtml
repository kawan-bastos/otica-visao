@page
@model ErrorModel
@{
    ViewData["Title"] = "Não foi possível concluir";
}

<main class="account-page">
    <section class="admin-empty">
        <span class="eyebrow">Algo não saiu como esperado</span>
        <h1>Não foi possível concluir esta ação</h1>
        <p>Tente novamente. Se o problema continuar, entre em contato com o responsável pelo sistema.</p>
        <a class="button button--primary" asp-page="/Index">Voltar ao início</a>
        @if (Model.ShowRequestId) { <small>Código de atendimento: @Model.RequestId</small> }
    </section>
</main>
