@page "/contato"
@{
    ViewData["Title"] = "Contato e localização";
}

<section class="institutional-hero institutional-hero--compact">
    <div class="site-container institutional-hero__content">
        <span class="eyebrow">Contato e localização</span>
        <h1>Estamos esperando por você em Piabetá.</h1>
        <p>Fale com nossa equipe, consulte uma armação ou venha conhecer a loja.</p>
    </div>
</section>

<section class="location section-shell">
    <div class="site-container location__grid">
        <div class="location__details">
            <span class="eyebrow eyebrow--dark">Ótica Visão de Piabetá</span>
            <h2>Informações da loja</h2>
            <div class="contact-list">
                <div><strong>Endereço</strong><span>Rua Arthur Rodrigues Loivos, 370<br />Piabetá, Magé - RJ</span></div>
                <div><strong>Horário</strong><span>Segunda a sexta: 9h às 17h<br />Sábado: 9h às 13h<br />Domingo: fechado</span></div>
                <div><strong>Telefone e WhatsApp</strong><a href="https://wa.me/5521965912440" target="_blank" rel="noopener noreferrer">(21) 96591-2440</a></div>
                <div><strong>Instagram</strong><a href="https://www.instagram.com/oticavisaodepiabeta/" target="_blank" rel="noopener noreferrer">@@oticavisaodepiabeta</a></div>
            </div>
            <div class="location__actions">
                <a class="button button--primary" href="https://wa.me/5521965912440?text=Ol%C3%A1%21%20Vim%20pelo%20site%20e%20gostaria%20de%20falar%20com%20a%20%C3%93tica%20Vis%C3%A3o." target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a>
                <a class="button button--secondary" href="https://www.google.com/maps?ftid=0x990b210649fb7b:0xb4f6083802a1481f" target="_blank" rel="noopener noreferrer">Abrir no Google Maps</a>
            </div>
        </div>
        <div class="location__map">
            <iframe title="Localização da Ótica Visão de Piabetá" src="https://www.google.com/maps?q=Rua%20Arthur%20Rodrigues%20Loivos%2C%20370%2C%20Piabet%C3%A1%2C%20Mag%C3%A9%2C%20RJ&amp;output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </div>
</section>

<section class="visit-information section-shell">
    <div class="site-container information-grid">
        <article><span aria-hidden="true">✓</span><h3>Exame de vista</h3><p>Realizado no local. Você pode agendar antes ou comparecer durante o horário de funcionamento.</p></article>
        <article><span aria-hidden="true">10x</span><h3>Pagamento facilitado</h3><p>Pix, cartão de débito e cartão de crédito em até 10x sem juros.</p></article>
        <article><span aria-hidden="true">3</span><h3>Garantia</h3><p>3 meses de garantia, exceto mau uso. Casos de quebra e outros danos ficam sujeitos à análise.</p></article>
    </div>
</section>
