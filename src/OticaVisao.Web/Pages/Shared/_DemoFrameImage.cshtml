@model Guid
@{
    // Only the original demonstration records receive illustrative photos.
    var image = Model.ToString() switch
    {
        "11111111-1111-1111-1111-111111111111" => "armacao-preta.png",
        "22222222-2222-2222-2222-222222222222" => "armacao-tartaruga.png",
        "33333333-3333-3333-3333-333333333333" => "armacao-preta.png",
        "44444444-4444-4444-4444-444444444444" => "armacao-tartaruga.png",
        "55555555-5555-5555-5555-555555555555" => "armacao-tartaruga.png",
        _ => null
    };
}
@if (image is not null)
{
    <figure class="demo-frame-image">
        <img src="~/images/demo/@image" alt="Armação ilustrativa para teste; não representa o produto anunciado" loading="lazy" />
        <figcaption>Imagem ilustrativa · teste</figcaption>
    </figure>
}
else
{
    <span class="frame-placeholder">Foto em breve</span>
}
