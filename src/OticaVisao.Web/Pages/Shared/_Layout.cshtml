<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Conheça as armações da Ótica Visão de Piabetá e fale com nossa equipe pelo WhatsApp." />
    <title>@ViewData["Title"] - Ótica Visão de Piabetá</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OticaVisao.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="topbar">
            <div class="site-container topbar__content">
                <span>Piabetá - RJ</span>
                <a href="#contato">WhatsApp da loja</a>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg site-nav" aria-label="Navegação principal">
            <div class="site-container nav-shell">
                <a class="brand" asp-area="" asp-page="/Index" aria-label="Ótica Visão - página inicial">
                    <span class="brand__eyebrow">Ótica</span>
                    <span class="brand__name">Visão</span>
                    <span class="brand__place">Piabetá</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                        aria-expanded="false" aria-label="Abrir menu de navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNavigation">
                    <ul class="navbar-nav nav-links ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link active" href="#inicio">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#armacoes">Armações</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#como-funciona">Como funciona</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#sobre">Sobre nós</a>
                        </li>
                        <li class="nav-item nav-item--cta">
                            <a class="button button--small button--whatsapp" href="#contato">Falar no WhatsApp</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">@RenderBody()</main>

    <footer class="site-footer">
        <div class="site-container site-footer__content">
            <div>
                <strong>Ótica Visão de Piabetá</strong>
                <p>Cuidando da sua visão com atendimento próximo e especializado.</p>
            </div>
            <p>&copy; @DateTime.Now.Year Ótica Visão. Todos os direitos reservados.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
