<!DOCTYPE html>
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var isHome = string.Equals(currentPage, "/Index", StringComparison.OrdinalIgnoreCase);
    var isCatalog = currentPage.StartsWith("/Frames", StringComparison.OrdinalIgnoreCase);
    var isAbout = string.Equals(currentPage, "/About", StringComparison.OrdinalIgnoreCase);
    var isContact = string.Equals(currentPage, "/Contact", StringComparison.OrdinalIgnoreCase);
}
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Conheça as armações da Ótica Visão de Piabetá e fale com nossa equipe pelo WhatsApp." />
    <title>@ViewData["Title"] - Ótica Visão de Piabetá</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OticaVisao.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="topbar">
            <div class="site-container topbar__content">
                <span class="topbar__location"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>Rua Arthur Rodrigues Loivos, 370 - Piabetá</span>
                <div class="topbar__actions">
                    <a href="https://wa.me/5521965912440" target="_blank" rel="noopener noreferrer"><span class="topbar__contact-label">Fale com a gente</span> WhatsApp: (21) 96591-2440 <span aria-hidden="true">↗</span></a>
                </div>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg site-nav" aria-label="Navegação principal">
            <div class="site-container nav-shell">
                <a class="brand" asp-area="" asp-page="/Index" aria-label="Ótica Visão - página inicial">
                    <img src="~/images/brand/logo-horizontal.png" alt="Ótica Visão de Piabetá" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                        aria-expanded="false" aria-label="Abrir menu de navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNavigation">
                    <ul class="navbar-nav nav-links nav-primary mx-lg-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "active" : null)" asp-page="/Index" asp-fragment="inicio" aria-current="@(isHome ? "page" : null)">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isCatalog ? "active" : null)" asp-page="/Frames/Index" aria-current="@(isCatalog ? "page" : null)">Armações</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Index" asp-fragment="como-funciona">Como funciona</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isAbout ? "active" : null)" asp-page="/About" aria-current="@(isAbout ? "page" : null)">Sobre nós</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isContact ? "active" : null)" asp-page="/Contact" aria-current="@(isContact ? "page" : null)">Contato</a>
                        </li>
                    </ul>
                    <div class="nav-actions">
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="button button--small button--account" asp-page="/Admin/Frames/Index">Painel</a>
                            <form method="post" asp-page="/Admin/Account/Logout"><button class="nav-action-link" type="submit">Sair</button></form>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="nav-action-link" asp-page="/Account/Index">Minha conta</a>
                            <a class="button button--small button--panel" asp-page="/Admin/Frames/Index">Painel</a>
                            <form method="post" asp-page="/Account/Logout"><button class="nav-action-link" type="submit">Sair</button></form>
                        }
                        else
                        {
                            <a class="nav-action-link" asp-page="/Account/Login">Entrar</a>
                            <a class="button button--small button--account" asp-page="/Account/Register">Cadastrar</a>
                            <a class="button button--small button--panel" asp-page="/Admin/Frames/Index">Painel</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">@RenderBody()</main>

    <footer class="site-footer">
        <div class="site-container footer-grid">
            <div class="footer-brand">
                <a class="footer-brand__logo" asp-page="/Index" aria-label="Ótica Visão - página inicial"><img src="~/images/brand/logo-horizontal.png" alt="Ótica Visão de Piabetá" width="176" height="72" /></a>
                <p>Ótica Visão de Piabetá</p>
                <a class="footer-instagram" href="https://www.instagram.com/oticavisaodepiabeta/" target="_blank" rel="noopener noreferrer">@@oticavisaodepiabeta <span aria-hidden="true">↗</span></a>
            </div>
            <section class="footer-column" aria-labelledby="footer-visit">
                <h2 id="footer-visit">Visite nossa loja</h2>
                <p>Rua Arthur Rodrigues Loivos, 370<br />Piabetá, Magé - RJ</p>
                <a asp-page="/Contact">Contato e localização <span aria-hidden="true">→</span></a>
            </section>
            <section class="footer-column" aria-labelledby="footer-hours">
                <h2 id="footer-hours">Horários de atendimento</h2>
                <dl class="footer-hours"><div><dt>Segunda a sexta</dt><dd>9h às 17h</dd></div><div><dt>Sábado</dt><dd>9h às 13h</dd></div></dl>
                <a class="footer-contact" href="https://wa.me/5521965912440" target="_blank" rel="noopener noreferrer">WhatsApp · (21) 96591-2440 <span aria-hidden="true">↗</span></a>
            </section>
        </div>
        <div class="site-container footer-bottom">
                <p>&copy; @DateTime.Now.Year Ótica Visão. Todos os direitos reservados.</p>
                <nav class="footer-bottom__links" aria-label="Links do rodapé">
                    <a asp-page="/About">Sobre nós</a>
                    <a asp-page="/Privacy">Privacidade</a>
                    @if (!User.IsInRole("Admin"))
                    {
                        <a asp-page="/Admin/Account/Login">Acesso administrativo</a>
                    }
                </nav>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
