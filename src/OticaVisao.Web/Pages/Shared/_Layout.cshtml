<!DOCTYPE html>
@using OticaVisao.Infrastructure.Authentication
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var isHome = string.Equals(currentPage, "/Index", StringComparison.OrdinalIgnoreCase);
    var isCatalog = currentPage.StartsWith("/Frames", StringComparison.OrdinalIgnoreCase);
    var isAbout = string.Equals(currentPage, "/About", StringComparison.OrdinalIgnoreCase);
    var isContact = string.Equals(currentPage, "/Contact", StringComparison.OrdinalIgnoreCase);
    var isAdminPage = currentPage.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase);
    var panelLandingPage = AdminAuthorization.GetPanelLandingPage(User);
}
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Conheça as armações da Ótica Visão de Piabetá e fale com nossa equipe pelo WhatsApp." />
    <title>@ViewData["Title"] - Ótica Visão de Piabetá</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OticaVisao.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="topbar">
            <div class="site-container topbar__content">
                <span class="topbar__location"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>Rua Arthur Rodrigues Loivos, 370 - Piabetá</span>
                <div class="topbar__actions">
                    <a href="https://wa.me/5521965912440" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp: (21) 96591-2440"><span class="topbar__contact-label">Fale com a gente</span><svg class="whatsapp-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.52 3.48A11.87 11.87 0 0 0 12.05 0C5.47 0 .12 5.35.12 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.28-1.65a11.9 11.9 0 0 0 5.77 1.47h.01c6.57 0 11.93-5.35 11.94-11.93a11.85 11.85 0 0 0-3.48-8.41ZM12.06 21.8a9.9 9.9 0 0 1-5.03-1.38l-.36-.21-3.73.98 1-3.64-.24-.38a9.87 9.87 0 0 1-1.52-5.24c0-5.46 4.44-9.9 9.89-9.9a9.82 9.82 0 0 1 7 2.9 9.82 9.82 0 0 1 2.9 7c0 5.45-4.45 9.89-9.91 9.89Zm5.42-7.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.8-1.49-1.78-1.66-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.1 4.49.71.3 1.27.48 1.7.61.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"/></svg><span>(21) 96591-2440</span><span aria-hidden="true">↗</span></a>
                </div>
            </div>
        </div>
        <nav class="site-nav" aria-label="Navegação principal">
            <div class="site-container nav-shell">
                <a class="brand" asp-area="" asp-page="/Index" aria-label="Ótica Visão - página inicial">
                    <img src="~/images/brand/logo-horizontal.png" alt="Ótica Visão de Piabetá" />
                </a>
                <div class="desktop-navigation">
                    <ul class="nav-links nav-primary">
                        <li><a class="nav-link @(isHome ? "active" : null)" asp-page="/Index" asp-fragment="inicio" aria-current="@(isHome ? "page" : null)">Início</a></li>
                        <li><a class="nav-link @(isCatalog ? "active" : null)" asp-page="/Frames/Index" aria-current="@(isCatalog ? "page" : null)">Armações</a></li>
                        <li><a class="nav-link" asp-page="/Index" asp-fragment="como-funciona">Como funciona</a></li>
                        <li><a class="nav-link @(isAbout ? "active" : null)" asp-page="/About" aria-current="@(isAbout ? "page" : null)">Sobre nós</a></li>
                        <li><a class="nav-link @(isContact ? "active" : null)" asp-page="/Contact" aria-current="@(isContact ? "page" : null)">Contato</a></li>
                    </ul>
                    <div class="nav-actions">
                        @if (User.IsInRole(OticaVisao.Infrastructure.Authentication.AdminAuthorization.Role))
                        {
                            <a class="nav-action-link" asp-page="/Account/Index">Minha conta</a>
                            <a class="button button--small button--account" asp-page="@panelLandingPage">Painel</a>
                            <form method="post" asp-page="/Admin/Account/Logout"><button class="nav-action-link" type="submit">Sair</button></form>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="nav-action-link" asp-page="/Account/Index">Minha conta</a>
                            <a class="button button--small button--account" asp-page="/Account/Reservations">Reservas</a>
                            <form method="post" asp-page="/Account/Logout"><button class="nav-action-link" type="submit">Sair</button></form>
                        }
                        else
                        {
                            <a class="nav-action-link" asp-page="/Account/Login">Entrar</a>
                            <a class="button button--small button--account" asp-page="/Account/Register">Cadastrar</a>
                        }
                    </div>
                </div>
                <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" aria-label="Abrir menu de navegação" data-mobile-menu-toggle>
                    <span></span><span></span><span></span>
                </button>
            </div>
        </nav>
                <div class="mobile-navigation" id="mobile-navigation" hidden>
                    <button class="mobile-navigation__backdrop" type="button" aria-label="Fechar menu" data-mobile-menu-close></button>
                    <aside class="mobile-navigation__panel" aria-label="Menu principal" aria-modal="true" role="dialog">
                        <header class="mobile-navigation__header"><a class="mobile-navigation__brand" asp-page="/Index" aria-label="Ótica Visão - página inicial"><img src="~/images/brand/logo-horizontal.png" alt="Ótica Visão de Piabetá" /></a><button class="mobile-navigation__close" type="button" aria-label="Fechar menu de navegação" data-mobile-menu-close><span aria-hidden="true"></span></button></header>
                        <nav class="mobile-navigation__main" aria-label="Links principais"><a class="@(isHome ? "active" : null)" asp-page="/Index" asp-fragment="inicio">Início</a><a class="@(isCatalog ? "active" : null)" asp-page="/Frames/Index">Armações</a><a asp-page="/Index" asp-fragment="como-funciona">Como funciona</a><a class="@(isAbout ? "active" : null)" asp-page="/About">Sobre nós</a><a class="@(isContact ? "active" : null)" asp-page="/Contact">Contato</a></nav>
                        <nav class="mobile-navigation__resources" aria-label="Recursos"><span>Recursos</span>@if (!User.IsInRole(AdminAuthorization.Role)) { <a asp-page="/Account/Reservations">Minhas reservas</a> }<a asp-page="/Privacy">Privacidade</a><a asp-page="/Terms">Termos de uso</a></nav>
                        <div class="mobile-navigation__footer">
                            @if (User.IsInRole(OticaVisao.Infrastructure.Authentication.AdminAuthorization.Role))
                            {
                                <a class="button mobile-navigation__ghost" asp-page="/Account/Index">Minha conta</a><a class="button button--primary" asp-page="@panelLandingPage">Acessar painel</a><form method="post" asp-page="/Admin/Account/Logout"><button class="mobile-navigation__signout" type="submit">Sair</button></form>
                            }
                            else if (User.Identity?.IsAuthenticated == true)
                            {
                                <a class="button mobile-navigation__ghost" asp-page="/Account/Index">Minha conta</a><a class="button button--primary" asp-page="/Account/Reservations">Ver reservas</a><form method="post" asp-page="/Account/Logout"><button class="mobile-navigation__signout" type="submit">Sair</button></form>
                            }
                            else
                            {
                                <a class="button mobile-navigation__ghost" asp-page="/Account/Login">Entrar</a><a class="button button--primary" asp-page="/Account/Register">Cadastrar</a>
                            }
                        </div>
                    </aside>
                </div>
    </header>
    <main role="main">@RenderBody()</main>

    <footer class="site-footer @(isAdminPage ? "site-footer--admin" : null)">
        @if (!isAdminPage)
        {
            <section class="site-container footer-cta" aria-labelledby="footer-cta-title">
                <div><span class="eyebrow">Atendimento de perto</span><h2 id="footer-cta-title">Vamos encontrar os óculos que combinam com você?</h2><p>Veja as armações online e conte com nossa equipe para escolher com calma na loja.</p></div>
                <div class="footer-cta__actions"><a class="button button--primary" asp-page="/Frames/Index">Ver armações</a><a class="button footer-cta__ghost" href="https://wa.me/5521965912440" target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a></div>
            </section>
        }
        <div class="site-container footer-grid">
            <div class="footer-brand">
                <a class="footer-brand__logo" asp-page="/Index" aria-label="Ótica Visão - página inicial"><img src="~/images/brand/logo-horizontal.png" alt="Ótica Visão de Piabetá" width="176" height="72" /></a>
                <p>Ótica Visão de Piabetá</p>
                <span class="footer-brand__description">Óculos, cuidado visual e atendimento próximo no coração de Piabetá.</span>
                <div class="footer-socials" aria-label="Canais da Ótica Visão">
                    <a href="https://www.instagram.com/oticavisaodepiabeta/" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><span aria-hidden="true">◎</span></a>
                    <a href="https://wa.me/5521965912440" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><span aria-hidden="true">◉</span></a>
                    <a asp-page="/Contact" aria-label="Localização da loja"><span aria-hidden="true">⌖</span></a>
                </div>
            </div>
            <nav class="footer-column" aria-labelledby="footer-explore"><h2 id="footer-explore">Explore</h2><a asp-page="/Frames/Index">Armações</a><a asp-page="/Index" asp-fragment="como-funciona">Como funciona</a>@if (!User.IsInRole(AdminAuthorization.Role)) { <a asp-page="/Account/Reservations">Minhas reservas</a> }</nav>
            <nav class="footer-column" aria-labelledby="footer-company"><h2 id="footer-company">Ótica Visão</h2><a asp-page="/About">Sobre nós</a><a asp-page="/Contact">Contato e localização</a><p>Rua Arthur Rodrigues Loivos, 370<br />Piabetá, Magé - RJ</p></nav>
            <section class="footer-column" aria-labelledby="footer-hours"><h2 id="footer-hours">Atendimento</h2><dl class="footer-hours"><div><dt>Segunda a sexta</dt><dd>9h às 17h</dd></div><div><dt>Sábado</dt><dd>9h às 13h</dd></div></dl><a class="footer-contact" href="https://wa.me/5521965912440" target="_blank" rel="noopener noreferrer">(21) 96591-2440 <span aria-hidden="true">↗</span></a></section>
        </div>
        <div class="site-container footer-bottom">
                <p>&copy; @DateTime.Now.Year Ótica Visão. Todos os direitos reservados.</p>
                <nav class="footer-bottom__links" aria-label="Links do rodapé">
                    <a asp-page="/Privacy">Privacidade</a>
                    <a asp-page="/Terms">Termos de uso</a>
                </nav>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
